<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_welcome_button_secondary" />

    <!-- Close X Button -->

    <!-- Success Confirmation Emblem Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_confirmation_emblem"
        android:contentDescription="@string/app_logo_desc" />

    <!-- Confirmation Title & Subtitle -->
    <TextView
        android:id="@+id/tv_approve_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Xác nhận nhận Mentee\nNguyễn Văn A?"
        android:textColor="@color/color_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/approve_subtitle"
        android:textColor="@color/color_text_hint"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btn_approve_start_chat"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_welcome_button_primary"
        app:backgroundTint="@null"
        android:text="@string/btn_approve_start_chat"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:elevation="0dp" />

    <Button
        android:id="@+id/btn_approve_later"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_welcome_button_secondary"
        app:backgroundTint="@null"
        android:text="@string/btn_later"
        android:textColor="@color/color_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:elevation="0dp" />

</LinearLayout>
