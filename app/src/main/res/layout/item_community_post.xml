<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- 1. Author Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar with Pink/Gradient Ring -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_welcome_button_secondary"
            android:padding="2dp">

            <ImageView
                android:id="@+id/iv_author_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/avata_nu"
                android:contentDescription="@string/app_logo_desc" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="yournamehere"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_verification_badge"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_successmark"
                    android:contentDescription="@string/app_logo_desc" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 hours ago"
                android:textColor="@color/color_text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_post_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_action_edit"
            android:contentDescription="@string/app_logo_desc"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. Post Content Text -->
    <TextView
        android:id="@+id/tv_post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="Một số tips mình rút ra sau khi apply học bổng thành công: chuẩn bị hồ sơ sớm, làm nổi bật các hoạt động ngoại khóa và thể hiện rõ mục tiêu của bản thân; Đừng quên chuẩn bị Motivation Letter sớm nhất có thể."
        android:textColor="@color/color_text_primary"
        android:textSize="13sp" />

    <!-- 3. Large Media Frame -->
    <ImageView
        android:id="@+id/iv_post_media"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:background="#E2E8F0"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_logo_desc" />

    <!-- 4. Connect With Mentor Action Bar -->
    <LinearLayout
        android:id="@+id/layout_connect_mentor"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connect_with_mentor"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@string/connect_with_mentor" />
    </LinearLayout>

    <!-- 5. Reaction and Sharing Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Likes -->
        <LinearLayout
            android:id="@+id/btn_like"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_like_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_like"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="188"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Comments -->
        <LinearLayout
            android:id="@+id/btn_comment"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_comment_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_chat"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="342"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shares -->
        <LinearLayout
            android:id="@+id/btn_share"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_share_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_share"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_share_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="718"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Bookmark -->
        <ImageView
            android:id="@+id/btn_bookmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_action_save_post"
            android:contentDescription="@string/app_logo_desc"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 6. Pagination Indicator Dots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_welcome_button_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_welcome_button_secondary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_welcome_button_secondary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_welcome_button_secondary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_welcome_button_secondary" />
    </LinearLayout>

    <!-- Post Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/color_border" />

</LinearLayout>
