<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1. Author Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_author_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avata_nam"
            android:contentDescription="@string/app_logo_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_verification_badge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_successmark"
                    android:visibility="gone"
                    android:contentDescription="@string/app_logo_desc" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 giờ trước"
                android:textColor="@color/color_text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_post_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_action_edit"
            android:contentDescription="@string/app_logo_desc" />
    </LinearLayout>

    <!-- 2. Post Content Text -->
    <TextView
        android:id="@+id/tv_post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Post content goes here"
        android:textColor="@color/color_text_primary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- 3. Large Media Area -->
    <ImageView
        android:id="@+id/iv_post_media"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:background="#E2E8F0"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_logo_desc" />

    <!-- 4. Connect With Mentor Action Row -->
    <LinearLayout
        android:id="@+id/layout_connect_mentor"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connect_with_mentor"
            android:textColor="@color/color_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@string/connect_with_mentor" />
    </LinearLayout>

    <!-- 5. Reaction and Sharing Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Likes -->
        <LinearLayout
            android:id="@+id/btn_like"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_like_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_like"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="188"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Comments -->
        <LinearLayout
            android:id="@+id/btn_comment"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_comment_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_chat"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="342"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shares -->
        <LinearLayout
            android:id="@+id/btn_share"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_share_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_share"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:id="@+id/tv_share_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="718"
                android:textColor="@color/color_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Bookmark -->
        <ImageView
            android:id="@+id/btn_bookmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_action_save_post"
            android:contentDescription="@string/app_logo_desc"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Post Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/color_border" />

</LinearLayout>
