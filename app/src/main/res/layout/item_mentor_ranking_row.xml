<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground">

    <!-- Column 1: Rank -->
    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="1"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Column 2: Mentor Name -->
    <TextView
        android:id="@+id/tv_mentor_name"
        android:layout_width="130dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Nguyen Kim Loan"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Column 3: Total -->
    <TextView
        android:id="@+id/tv_total"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="94.7%"
        android:textColor="@color/color_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Column 4: Mentee Success Rate -->
    <TextView
        android:id="@+id/tv_success_rate"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="92%"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp" />

    <!-- Column 5: Average Rating -->
    <TextView
        android:id="@+id/tv_avg_rating"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="4.9/5"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp" />

    <!-- Column 6: Completion Rate -->
    <TextView
        android:id="@+id/tv_completion_rate"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="96%"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp" />

    <!-- Column 7: Response Rate -->
    <TextView
        android:id="@+id/tv_response_rate"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="98%"
        android:textColor="@color/color_text_primary"
        android:textSize="12sp" />

</LinearLayout>
