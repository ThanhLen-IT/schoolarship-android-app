<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_field"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Post Title -->
    <TextView
        android:id="@+id/tv_post_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="Kinh nghiệm apply NUS: xây dựng hồ sơ nhật đạt quán"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Author Name -->
    <TextView
        android:id="@+id/tv_post_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dr. Nguyen"
        android:textColor="@color/color_text_hint"
        android:textSize="12sp" />

    <!-- Hashtag -->
    <TextView
        android:id="@+id/tv_post_hashtag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="#HocBongNUS"
        android:textColor="@color/color_primary"
        android:textSize="12sp" />

    <!-- Action Row: Bỏ lưu Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_unbookmark"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_welcome_button_secondary"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/unbookmark_label"
            android:textColor="@color/color_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
