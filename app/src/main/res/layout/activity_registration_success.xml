<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/color_surface"
    tools:context=".RegistrationSuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Section A: Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="40dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_name"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textAppearance="@style/TextAppearance.App.Headline" />
        </LinearLayout>

        <!-- Section B: Success Icon -->
        <ImageView
            android:id="@+id/iv_success"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_successmark"
            android:contentDescription="@string/success_icon_desc" />

        <!-- Section C: Confirmation Heading -->
        <TextView
            android:id="@+id/tv_success_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/registration_success_title"
            android:textColor="@color/color_text_primary"
            android:textSize="26sp"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:layout_marginBottom="12dp" />

        <!-- Section D: Confirmation Message -->
        <TextView
            android:id="@+id/tv_success_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/registration_success_message"
            android:textColor="@color/color_text_hint"
            android:textSize="14sp"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_success_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/registration_success_subtitle"
            android:textColor="@color/color_text_hint"
            android:textSize="14sp"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:layout_marginBottom="40dp" />

        <!-- Section E: Primary Action (Continue to Log In) -->
        <Button
            android:id="@+id/btn_continue_to_login"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_welcome_button_primary"
            app:backgroundTint="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/continue_to_login"
            android:textAppearance="@style/TextAppearance.App.CTA"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Section F: Optional Secondary Action (Back to Welcome) -->
        <TextView
            android:id="@+id/tv_back_to_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/back_to_welcome"
            android:textColor="@color/color_primary"
            android:textSize="13sp"
            android:textAppearance="@style/TextAppearance.App.Body" />

    </LinearLayout>
</ScrollView>