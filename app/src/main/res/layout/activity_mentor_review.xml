<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    tools:context=".MentorReviewActivity">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back_mentor_review"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back_button_desc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/mentor_review_title"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Scrollable Review Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Main White Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mentor_review_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Scholarship & Mentor Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_scholarship_logo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pic1"
                        android:contentDescription="@string/app_logo_desc" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_scholarship_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Học bổng Chevening"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mentor_services"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sửa luận, Mock interview"
                            android:textColor="@color/color_text_hint"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E2E8F0" />

                <!-- Mentor Rating Stars Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_rate_mentor"
                    android:textColor="@color/color_text_hint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_star_1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFB51B"
                        android:contentDescription="@string/label_rate_mentor"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/iv_star_2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFB51B"
                        android:contentDescription="@string/label_rate_mentor"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/iv_star_3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFB51B"
                        android:contentDescription="@string/label_rate_mentor"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/iv_star_4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFB51B"
                        android:contentDescription="@string/label_rate_mentor"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/iv_star_5"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFB51B"
                        android:contentDescription="@string/label_rate_mentor"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E2E8F0" />

                <!-- Evidence Upload Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_add_evidence"
                    android:textColor="@color/color_text_hint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btn_upload_evidence"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_review_evidence_upload"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_action_camera"
                        app:tint="#334155"
                        android:contentDescription="@string/label_add_evidence" />

                    <TextView
                        android:id="@+id/tv_evidence_filename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:text="@string/hint_upload_evidence"
                        android:textColor="@color/color_text_hint"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Written Review Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_write_review_50"
                    android:textColor="@color/color_text_hint"
                    android:textSize="13sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/et_review_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_review_text_input"
                        android:gravity="top|start"
                        android:hint="@string/hint_review_placeholder"
                        android:inputType="textMultiLine"
                        android:padding="10dp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="12sp"
                        android:autofillHints="" />

                    <TextView
                        android:id="@+id/tv_review_char_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="8dp"
                        android:text="0 ký tự"
                        android:textColor="@color/color_text_hint"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- Anonymous Checkbox -->
                <CheckBox
                    android:id="@+id/cb_anonymous_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/checkbox_anonymous_review"
                    android:textColor="#334155"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Submit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_submit_review"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_welcome_button_primary"
            app:backgroundTint="@null"
            android:text="@string/btn_submit_label"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
