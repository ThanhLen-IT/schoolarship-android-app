<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/color_surface"
    tools:context=".VerifyCodeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Section A: Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back_button_desc" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_logo_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_name"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textAppearance="@style/TextAppearance.App.Headline" />
        </LinearLayout>

        <!-- Section B: Main Heading -->
        <TextView
            android:id="@+id/tv_verify_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_email_title"
            android:textColor="@color/color_text_primary"
            android:textSize="26sp"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <!-- Section C: Verification Message -->
        <TextView
            android:id="@+id/tv_verify_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="32dp"
            android:text="@string/verify_email_message_generic"
            android:textColor="@color/color_text_hint"
            android:textSize="14sp"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <!-- Section D: Five Code-Entry Boxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/et_code_1"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:singleLine="true"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:autofillHints="" />

            <EditText
                android:id="@+id/et_code_2"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:singleLine="true"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:autofillHints="" />

            <EditText
                android:id="@+id/et_code_3"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:singleLine="true"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:autofillHints="" />

            <EditText
                android:id="@+id/et_code_4"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:singleLine="true"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:autofillHints="" />

            <EditText
                android:id="@+id/et_code_5"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:singleLine="true"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:autofillHints="" />

        </LinearLayout>

        <!-- Section E: Verify Code Button -->
        <Button
            android:id="@+id/btn_verify_code"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_welcome_button_primary"
            app:backgroundTint="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/verify_code"
            android:textAppearance="@style/TextAppearance.App.CTA"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Section F: Resend Email Prompt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_resend_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/resend_email_prompt"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_text_hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_resend_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/resend_email"
                android:textAppearance="@style/TextAppearance.App.Button"
                android:textColor="@color/color_primary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>