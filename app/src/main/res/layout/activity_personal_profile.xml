<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/color_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<Button android:id="@+id/btn_profile_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_back" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_info_title" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/color_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/local_profile_notice" android:textColor="@color/color_text_hint" />
<ImageView android:id="@+id/iv_edit_avatar" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="16dp" android:layout_gravity="center_horizontal" android:scaleType="centerCrop" android:src="@drawable/ic_nav_profile" android:contentDescription="@string/profile_avatar" />
<Button android:id="@+id/btn_pick_avatar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_pick_avatar" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/et_profile_name" android:layout_marginTop="16dp" android:text="Họ và tên" android:textColor="@color/color_primary" />
<EditText android:id="@+id/et_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textPersonName" android:maxLength="80" android:gravity="top|start" android:textColor="@color/color_text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/et_profile_university" android:layout_marginTop="16dp" android:text="Trường đại học" android:textColor="@color/color_primary" />
<EditText android:id="@+id/et_profile_university" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:maxLength="160" android:gravity="top|start" android:textColor="@color/color_text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/et_profile_major" android:layout_marginTop="16dp" android:text="Ngành học" android:textColor="@color/color_primary" />
<EditText android:id="@+id/et_profile_major" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:maxLength="160" android:gravity="top|start" android:textColor="@color/color_text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/et_profile_bio" android:layout_marginTop="16dp" android:text="Giới thiệu" android:textColor="@color/color_primary" />
<EditText android:id="@+id/et_profile_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textMultiLine" android:maxLength="500" android:gravity="top|start" android:textColor="@color/color_text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/et_profile_skills" android:layout_marginTop="16dp" android:text="Kỹ năng (phân cách bằng dấu phẩy)" android:textColor="@color/color_primary" />
<EditText android:id="@+id/et_profile_skills" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:maxLength="250" android:gravity="top|start" android:textColor="@color/color_text_primary" />
<Button android:id="@+id/btn_profile_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/profile_edit" />
<Button android:id="@+id/btn_profile_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_save" />
<Button android:id="@+id/btn_profile_cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancel_button" />
</LinearLayout></ScrollView>
