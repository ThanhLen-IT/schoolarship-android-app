<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/color_surface"
    tools:context=".RegistrationSuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Left Region: Brand Header & Success Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/app_logo_desc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/brand_name"
                    android:textColor="@color/color_primary"
                    android:textSize="14sp"
                    android:textAppearance="@style/TextAppearance.App.Headline" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_success"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_successmark"
                android:contentDescription="@string/success_icon_desc" />
        </LinearLayout>

        <!-- Right Region: Heading, Message, Button, Secondary Link -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_success_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_success_title"
                android:textColor="@color/color_text_primary"
                android:textSize="24sp"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_success_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_success_message"
                android:textColor="@color/color_text_hint"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_success_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_success_subtitle"
                android:textColor="@color/color_text_hint"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_continue_to_login"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_welcome_button_primary"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/continue_to_login"
                android:textAppearance="@style/TextAppearance.App.CTA"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_back_to_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="4dp"
                android:text="@string/back_to_welcome"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.App.Body" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>