<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= BUTTON ================= -->
    <!-- Nut chinh: "Log In", "Register", "Kham pha co hoi" -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Nut vien: "Continue with Google / Facebook" -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="iconTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Nut chu: "Forgot Password?", "Sign Up", "Xem tat ca" -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.App.Link</item>
        <item name="android:textColor">@color/color_link</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
    </style>

    <!-- ================= INPUT ================= -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/color_border</item>
        <item name="boxStrokeWidth">@dimen/stroke_width</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.Label</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="errorTextColor">@color/color_error</item>
    </style>

    <!-- Dung cho TextInputEditText ben trong -->
    <style name="Widget.App.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
        <item name="android:textColorHint">@color/color_text_hint</item>
    </style>

    <!-- Thanh tim kiem Home: "Tim hoc bong, Mentor, linh vuc..." -->
    <style name="Widget.App.SearchBar" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_xl</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/color_secondary</item>
    </style>

    <!-- ================= CARD ================= -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Card co vien, khong bong: card Streak / Xep hang -->
    <style name="Widget.App.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <!-- Banner Home (nen xanh nhat) -->
    <style name="Widget.App.Card.Banner">
        <item name="cardBackgroundColor">@color/color_primary_container</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- ================= CHIP / BADGE ================= -->
    <!-- "Toan phan", "Ban phan" -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="chipBackgroundColor">@color/color_primary_container</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/radius_sm</item>
        <item name="chipStartPadding">@dimen/space_sm</item>
        <item name="chipEndPadding">@dimen/space_sm</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:clickable">false</item>
    </style>

    <!-- Badge "Gold Mentor" tren header Profile -->
    <style name="Widget.App.Chip.Gold">
        <item name="android:textColor">@color/color_on_gold</item>
        <item name="chipBackgroundColor">@color/color_gold</item>
    </style>

    <!-- ================= PROGRESS ================= -->
    <!-- "85/100 XP" -->
    <style name="Widget.App.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_height</item>
        <item name="trackCornerRadius">@dimen/radius_pill</item>
        <item name="trackColor">@color/color_primary_container</item>
        <item name="indicatorColor">@color/color_link</item>
    </style>

    <!-- ================= BOTTOM NAV ================= -->
    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.BottomNav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.BottomNav</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ================= HEADER / LIST ================= -->
    <!-- Logo + "GLOBAL SUCCESS" -->
    <style name="Widget.App.BrandText" parent="">
        <item name="android:textAppearance">@style/TextAppearance.App.Brand</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Hang menu Profile: "Dang ky lam mentor", "Quan ly Mentee"... -->
    <style name="Widget.App.MenuItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Duong ke "Or" giua cac nut dang nhap -->
    <style name="Widget.App.Divider" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/stroke_width</item>
        <item name="android:background">@color/color_border</item>
    </style>

    <!-- O heatmap streak (doi mau theo muc XP bang backgroundTint) -->
    <style name="Widget.App.HeatmapCell" parent="">
        <item name="android:layout_width">@dimen/heatmap_cell</item>
        <item name="android:layout_height">@dimen/heatmap_cell</item>
        <item name="android:layout_margin">@dimen/heatmap_gap</item>
        <item name="android:background">@drawable/bg_heatmap_cell</item>
    </style>

    <!-- ================= BOTTOM SHEET / DIALOG (dung khi thiet ke co) ================= -->
    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomSheet</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="android:elevation">@dimen/elevation_bottom_sheet</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Text</item>
    </style>

    <style name="MaterialAlertDialog.App.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
    </style>

    <style name="MaterialAlertDialog.App.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- Lop phu toi tren anh (banner, card hoc bong) -->
    <style name="Widget.App.ImageOverlay" parent="">
        <item name="android:background">@color/color_overlay_image</item>
    </style>

    <!-- Icon Mac Dinh (24dp, mau primary) -->
        <style name="Widget.App.Icon" parent="">
            <item name="android:layout_width">@dimen/icon_lg</item>
            <item name="android:layout_height">@dimen/icon_lg</item>
            <item name="tint">@color/color_primary</item>
        </style>

        <!-- Icon Secondary/Subdued (danh cho Search Hint, Navigation, Subtitle) -->
        <style name="Widget.App.Icon.Secondary">
            <item name="tint">@color/color_secondary</item>
        </style>

        <!-- Icon Nho (16dp - dung trong Chip, Caption, Badge) -->
        <style name="Widget.App.Icon.Small">
            <item name="android:layout_width">@dimen/icon_sm</item>
            <item name="android:layout_height">@dimen/icon_sm</item>
        </style>

</resources>